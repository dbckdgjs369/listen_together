<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!--
        핫스팟에 필요하다. 없으면 startLocalOnlyHotspot 이
        "SecurityException: ConnectivityService: Neither user … nor current process
        has android.permission.ACCESS_NETWORK_STATE" 로 떨어진다.

        안드로이드 14 는 그냥 통과시켜서, 신형 기기로만 시험하면 절대 안 걸린다.
        노트9(안드로이드 10)에서만 재현됐다.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 비콘을 받으려면 필요하다. 이유는 startDiscovery 주석에 적어놨다. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Android 11+ 는 다른 앱의 존재를 기본적으로 숨긴다.
        여기 선언하지 않으면 getPackageInfo/getPackageUid 가 "없는 앱"으로 떨어져
        공유 대상 목록이 비고, 화이트리스트도 적용되지 않는다.
    -->
    <queries>
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.iloen.melon" />
        <package android:name="com.ktmusic.geniemusic" />
        <package android:name="com.spotify.music" />
        <package android:name="com.neowiz.android.bugs" />
        <package android:name="skplanet.musicmate" />
        <package android:name="com.sec.android.app.music" />
        <package android:name="com.apple.android.music" />
        <package android:name="com.soundcloud.android" />
        <package android:name="com.netflix.mediaclient" />
    </queries>

    <application
        android:label="같이 듣기"
        android:icon="@android:drawable/ic_media_play"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|mediaPlayback" />

        <service
            android:name=".PlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
