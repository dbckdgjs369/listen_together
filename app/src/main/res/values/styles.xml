<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      화면 조각의 모양은 여기서만 정한다. 예전엔 버튼·카드를 코드에서 매번 새로 그려서
      같은 "보조 버튼"이 자리마다 모서리와 글씨 크기가 조금씩 달랐다.

      글씨 단계: 제목 24 · 시트 제목 21 · 본문 15~16 · 보조 13 · 작은 안내 12.
    -->
    <style name="Btn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <!-- 머티리얼 버튼의 눌림 그림자. 평평한 화면에서 버튼만 떠 보인다 -->
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Btn.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>
    <style name="Btn.Ghost">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Btn.Danger">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="SheetTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="SheetLead">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Fine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:singleLine">true</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
    <style name="Grab">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginBottom">20dp</item>
        <item name="android:background">@drawable/bg_grab</item>
    </style>
    <style name="Icon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:tint">@color/text_dim</item>
    </style>
    <style name="IconBtn">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:background">@drawable/bg_icon_btn</item>
        <item name="android:tint">@color/text_dim</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!--
      바텀시트. 플랫폼 AlertDialog 는 모서리·버튼·글꼴이 앱과 따로 놀아서
      "만들다 만" 인상의 큰 원인이었다. 모양은 전부 우리 레이아웃이 그린다.
    -->
    <style name="Sheet" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@style/SheetAnim</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorHighlight">#556C5CE7</item>
        <item name="android:colorControlActivated">@color/accent</item>
    </style>
    <style name="SheetAnim">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
</resources>
