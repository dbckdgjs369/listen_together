<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="20dp">

    <View style="@style/Grab" />

    <TextView style="@style/SheetTitle" android:paddingStart="8dp" android:text="@string/settings" />

    <LinearLayout
        android:id="@+id/rowBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_row_flat"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView style="@style/Icon" android:src="@drawable/ic_battery" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_sheet_battery"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/batterySub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_dim"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/batteryChev"
            style="@style/Icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chev"
            android:tint="@color/text_faint" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowDirect"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_row_flat"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView style="@style/Icon" android:src="@drawable/ic_link" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/direct_title"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <ImageView
            style="@style/Icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chev"
            android:tint="@color/text_faint" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:minHeight="64dp"
        android:paddingStart="8dp"
        android:paddingTop="20dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <ImageView style="@style/Icon" android:src="@drawable/ic_info" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_sheet_net_info"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <!-- 길게 눌러 복사. 브라우저 주소창에 그대로 넣는 값이다 -->
            <TextView
                android:id="@+id/netInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_dim"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/version"
        style="@style/Fine"
        android:layout_marginTop="8dp" />
</LinearLayout>
