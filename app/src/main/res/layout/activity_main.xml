<?xml version="1.0" encoding="utf-8"?>
<!--
  화면 셋이 한 액티비티에 겹쳐 있고 상태에 따라 하나만 보인다.
    홈      : 공유하기 / 근처의 방
    공유 중 : 방 코드 · 비밀번호가 주인공
    듣는 중 : 무엇을 듣는지, 잘 되고 있는지

  예전엔 호스트 기능과 참여자 기능이 한 스크롤에 전부 쌓여 있었다.
  한 사람이 동시에 하는 건 둘 중 하나뿐이다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ── 홈 ─────────────────────────────────────── -->
        <ScrollView
            android:id="@+id/screenHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical">

                    <!-- 이음 = 잇다 + 音(소리). 한자는 작게 곁들여 두 번째 뜻만 살짝 비친다 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="이음"
                            android:textColor="@color/text"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02" />

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="9dp"
                            android:background="@drawable/bg_seal"
                            android:gravity="center"
                            android:rotation="-6"
                            android:text="音"
                            android:textColor="#B7ACFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnSettings"
                        style="@style/IconBtn"
                        android:layout_marginEnd="-10dp"
                        android:contentDescription="설정"
                        android:src="@drawable/ic_gear" />
                </LinearLayout>

                <!-- 듣는 중에 홈으로 나왔을 때만. 누르면 듣는 화면으로 돌아간다 -->
                <LinearLayout
                    android:id="@+id/miniPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_row"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:visibility="gone">

                    <View
                        android:id="@+id/miniDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot"
                        android:backgroundTint="@color/live" />

                    <TextView
                        android:id="@+id/miniText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chev"
                        android:tint="@color/text_faint" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/heroShare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_hero"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- 카드 전체를 덮어야 하므로 여백은 카드가 아니라 안쪽 글 묶음에 준다 -->
                    <com.example.lt.HeroRippleView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="22dp"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_hero_icon">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_speaker" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="22dp"
                            android:text="내 소리 공유하기"
                            android:textColor="#FFFFFFFF"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="3dp"
                            android:text="이 폰에서 나는 소리를\n근처 사람들과 함께 들어요"
                            android:textColor="#C7FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:paddingStart="2dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="근처의 방"
                        android:textColor="@color/text_dim"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/scanDots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/roomList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/emptyRooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="28dp"
                    android:paddingBottom="28dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_wifi"
                        android:tint="@color/text_faint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="아직 근처에 방이 없어요"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="같은 Wi-Fi 에서 누군가 공유를 시작하면\n여기에 바로 떠요"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />

                    <!-- 한동안 방이 안 보이면 MainActivity 가 띄운다 (EMPTY_HINT_MS) -->
                    <TextView
                        android:id="@+id/emptyHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_row_flat"
                        android:lineSpacingExtra="3dp"
                        android:padding="12dp"
                        android:text="카페·호텔 같은 공용 Wi-Fi 는 기기끼리 연결을 막아서 방이 안 보일 수 있어요. 호스트에게 ‘와이파이 없이 연결’을 켜 달라고 하고, 그 핫스팟에 접속해 보세요."
                        android:textColor="@color/text_dim"
                        android:textSize="12.5sp"
                        android:visibility="gone" />
                </LinearLayout>


                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="24dp" />

                <LinearLayout
                    android:id="@+id/btnCode"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_row_flat"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="방이 안 보이나요? 방 코드로 들어가기"
                        android:textColor="@color/text_dim"
                        android:textSize="14sp" />

                    <ImageView
                        style="@style/Icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_chev" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ── 공유 중 ─────────────────────────────────── -->
        <ScrollView
            android:id="@+id/screenHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/btnHostBack"
                        style="@style/IconBtn"
                        android:layout_marginStart="-10dp"
                        android:layout_marginEnd="2dp"
                        android:contentDescription="홈으로"
                        android:src="@drawable/ic_back" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_pill_live"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp">

                        <View
                            android:id="@+id/liveDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dot"
                            android:backgroundTint="@color/live" />

                        <TextView
                            android:id="@+id/livePill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:ellipsize="end"
                            android:maxWidth="220dp"
                            android:singleLine="true"
                            android:textColor="@color/live"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/btnSettingsHost"
                        style="@style/IconBtn"
                        android:layout_marginEnd="-10dp"
                        android:contentDescription="설정"
                        android:src="@drawable/ic_gear" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="26dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="방 코드"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />

                    <!-- 눌러서 복사. 불러주거나 메신저로 옮길 값이다 -->
                    <TextView
                        android:id="@+id/codeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_row_flat"
                        android:fontFeatureSettings="tnum"
                        android:letterSpacing="0.12"
                        android:paddingStart="12dp"
                        android:paddingEnd="6dp"
                        android:textColor="@color/text"
                        android:textSize="46sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/pwChip"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="비밀번호"
                            android:textColor="@color/text_dim"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/pwText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFeatureSettings="tnum"
                            android:letterSpacing="0.18"
                            android:textColor="@color/text"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp">

                        <LinearLayout
                            android:id="@+id/btnSendLink"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_ghost"
                            android:gravity="center">

                            <ImageView
                                style="@style/Icon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_share"
                                android:tint="@color/text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="링크 보내기"
                                android:textColor="@color/text"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnShowQr"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_ghost"
                            android:gravity="center">

                            <ImageView
                                style="@style/Icon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_qr"
                                android:tint="@color/text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="QR 보기"
                                android:textColor="@color/text"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/hostHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="듣는 사람"
                            android:textColor="@color/text"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/listenerCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_dim"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        android:id="@+id/rowHotspot"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_row_flat"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="와이파이 없이 연결"
                            android:textColor="@color/text"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/hotspotState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_dim"
                            android:textSize="14sp" />

                        <ImageView
                            style="@style/Icon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_chev"
                            android:tint="@color/text_faint" />
                    </LinearLayout>
                </LinearLayout>


                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="32dp" />

                <Button
                    android:id="@+id/btnStop"
                    style="@style/Btn.Danger"
                    android:text="공유 중지" />
            </LinearLayout>
        </ScrollView>

        <!-- ── 듣는 중 ─────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/screenListen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnListenBack"
                    style="@style/IconBtn"
                    android:layout_marginStart="-10dp"
                    android:contentDescription="홈으로"
                    android:src="@drawable/ic_back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="같이 듣는 중"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="34dp"
                    android:layout_height="0dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.example.lt.PulseView
                    android:id="@+id/pulse"
                    android:layout_width="240dp"
                    android:layout_height="240dp" />

                <TextView
                    android:id="@+id/listenName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="@color/text"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/listenDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot"
                        android:backgroundTint="@color/live" />

                    <TextView
                        android:id="@+id/listenState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/live"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp">

                    <LinearLayout
                        android:layout_width="92dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_stat"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="지연"
                            android:textColor="@color/text_dim"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/statLatency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="92dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_stat"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="수신"
                            android:textColor="@color/text_dim"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/statSignal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="92dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_stat"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="음질"
                            android:textColor="@color/text_dim"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/statQuality"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnRetryPw"
                    style="@style/Btn.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="28dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="비밀번호 다시 입력"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>


            <TextView
                style="@style/Fine"
                android:layout_marginBottom="14dp"
                android:text="가운데를 누르면 소리를 꺼요 · 볼륨은 옆 버튼으로" />

            <Button
                android:id="@+id/btnLeave"
                style="@style/Btn.Ghost"
                android:text="그만 듣기" />
        </LinearLayout>

        <!-- 잠깐 띄우는 알림. 토스트는 기기마다 모양이 달라 앱과 따로 논다 -->
        <TextView
            android:id="@+id/snack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="88dp"
            android:background="@drawable/bg_snack"
            android:elevation="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 광고는 세 화면 공통으로 맨 아래 한 자리. 내용 사이에 끼우면 목록·버튼과 헷갈린다 -->
    <include
        android:id="@+id/adBar"
        layout="@layout/ad_slot" />
</LinearLayout>
