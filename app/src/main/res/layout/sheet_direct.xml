<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View style="@style/Grab" />

    <TextView style="@style/SheetTitle" android:text="주소로 직접 들어가기" />
    <TextView style="@style/SheetLead" android:text="자동 발견이 막힌 와이파이에서 써요. 호스트의 설정 › 연결 정보에 주소가 있어요." />

    <EditText
        android:id="@+id/ipInput"
        style="@style/Input"
        android:layout_marginTop="20dp"
        android:hint="192.168.0.2"
        android:imeOptions="actionNext"
        android:inputType="textUri"
        android:fontFeatureSettings="tnum" />

    <EditText
        android:id="@+id/pwInput"
        style="@style/Input"
        android:layout_marginTop="8dp"
        android:hint="비밀번호 4자리"
        android:imeOptions="actionGo"
        android:inputType="number"
        android:maxLength="4" />

    <Button
        android:id="@+id/btnGo"
        style="@style/Btn.Primary"
        android:layout_marginTop="20dp"
        android:text="듣기" />
</LinearLayout>
