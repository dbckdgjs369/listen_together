<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View style="@style/Grab" />

    <TextView style="@style/SheetTitle" android:text="@string/create_title" />
    <TextView style="@style/SheetLead" android:text="@string/create_lead" />

    <EditText
        android:id="@+id/nameInput"
        style="@style/Input"
        android:layout_marginTop="20dp"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLength="20" />

    <Button
        android:id="@+id/btnStart"
        style="@style/Btn.Primary"
        android:layout_marginTop="20dp"
        android:text="@string/create_start" />

    <!--
      다음 동의 창이 "화면 녹화" 라고 뜨는 걸 여기서 미리 풀어준다.
      놀란 뒤에 설명하는 것과 순서가 다르다.
    -->
    <TextView
        android:id="@+id/consentText"
        style="@style/Fine"
        android:layout_marginTop="14dp" />
</LinearLayout>
