<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View style="@style/Grab" />

    <TextView style="@style/SheetTitle" android:text="@string/hotspot_title" />
    <TextView style="@style/SheetLead" android:text="@string/hotspot_lead" />

    <ImageView
        android:id="@+id/hsQr"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_qr"
        android:padding="14dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hsInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_dim"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/hsToggle"
        style="@style/Btn.Primary"
        android:layout_marginTop="20dp" />
</LinearLayout>
