<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View style="@style/Grab" />

    <TextView style="@style/SheetTitle" android:text="방 코드로 들어가기" />
    <TextView style="@style/SheetLead" android:text="호스트 화면 가운데 크게 보이는 코드예요.\n비밀번호가 들어 있어서 따로 칠 필요가 없어요." />

    <EditText
        android:id="@+id/codeInput"
        style="@style/Input"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:hint="GQQ47J"
        android:imeOptions="actionGo"
        android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
        android:letterSpacing="0.2"
        android:maxLength="14"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/codeError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="코드를 읽을 수 없어요 — 다시 확인해 주세요"
        android:textColor="@color/danger"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnGo"
        style="@style/Btn.Primary"
        android:layout_marginTop="20dp"
        android:enabled="false"
        android:text="들어가기" />
</LinearLayout>
